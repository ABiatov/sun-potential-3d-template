{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./map_layers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["map", "elevation", "layers"],
  "properties": {
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crs", "proj4", "center", "center_crs", "zoom", "pitch", "bearing", "extent_size", "terrain_enabled"],
      "properties": {
        "crs": { "type": "string", "minLength": 1 },
        "proj4": { "type": "string", "minLength": 1 },
        "center": {
          "type": "array",
          "items": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "center_crs": { "type": "string", "minLength": 1 },
        "zoom": { "type": "number", "minimum": 0 },
        "pitch": { "type": "number", "minimum": 0, "maximum": 85 },
        "bearing": { "type": "number" },
        "extent_size": {
          "type": "array",
          "items": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }],
          "minItems": 2,
          "maxItems": 2
        },
        "background_color": { "type": "string" },
        "elevation_no_colormap_background_color": { "type": "string" },
        "terrain_enabled": { "type": "boolean" },
        "layer_offsets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overlay_terrain_on_z": { "type": "number" },
            "overlay_terrain_off_z": { "type": "number" }
          }
        },
        "mask_layer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "type", "url", "mask_mode", "fill_color", "is_active"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["geojson_mask"] },
            "url": { "type": "string", "minLength": 1 },
            "data_projection": { "type": "string", "minLength": 1 },
            "mask_mode": { "type": "string", "enum": ["normal", "inverted"] },
            "fill_color": { "type": "string" },
            "is_active": { "type": "boolean" }
          }
        },
        "hillshading": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "is_masked": { "type": "boolean" },
            "azimuth": { "type": "number", "minimum": 0, "maximum": 360 },
            "zenith": { "type": "number", "minimum": 0, "maximum": 90 },
            "intensity": { "type": "number", "minimum": 0 },
            "z_factor": { "type": "number", "minimum": 0 },
            "elevation_layers_only": { "type": "boolean" }
          }
        }
      }
    },
    "elevation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source", "channels", "min", "max", "resolution_factor", "is_active", "is_masked"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "format": { "type": "string" },
        "source": { "type": "string", "minLength": 1 },
        "channels": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 1,
          "maxItems": 4
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "resolution_factor": { "type": "number", "exclusiveMinimum": 0 },
        "is_active": { "type": "boolean" },
        "is_masked": { "type": "boolean" }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "url", "channels", "is_active", "is_masked", "z_order", "style_config"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["cog_raster", "cog_rgb", "cog_terrain", "copc_point_cloud"]
          },
          "url": { "type": "string", "minLength": 1 },
          "channels": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 1,
            "maxItems": 4
          },
          "is_active": { "type": "boolean" },
          "is_masked": { "type": "boolean" },
          "z_order": { "type": "integer" },
          "style_config": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
              "blending_mode": {
                "type": "string",
                "enum": ["none", "normal", "add", "multiply"]
              },
              "nodata": { "type": "number" },
              "colormap_name": { "type": "string" },
              "value_range": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min", "max"],
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" }
                }
              },
              "palette": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "color"],
                  "properties": {
                    "value": { "type": "number" },
                    "color": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$" }
                  }
                }
              },
              "attribute": { "type": "string", "minLength": 1 },
              "point_size": { "type": "number", "minimum": 0 },
              "subdivision_threshold": { "type": "number", "exclusiveMinimum": 0 },
              "decimate": { "type": "integer", "minimum": 1 },
              "enable_workers": { "type": "boolean" },
              "compress_colors_to_8bit": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
