# Application
VITE_APP_NAME=Sun Potential 3D Viewer Template
VITE_APP_ENV=development

# API
VITE_API_BASE_URL=http://localhost:8080

# Customer profile
VITE_DEFAULT_CUSTOMER=demo

# Features
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_DEBUG=false

# Map defaults
VITE_MAP_INITIAL_LAT=
VITE_MAP_INITIAL_LNG=
VITE_MAP_INITIAL_ZOOM=15

# Если будут фичефлаги, можно так:
VITE_ENABLE_SOLAR_LAYER=true
VITE_ENABLE_REPORTS=false
VITE_ENABLE_WHITE_LABEL=true
